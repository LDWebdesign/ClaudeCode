{
  "name": "residual",
  "version": "1.0.0",
  "private": true,
  "description": "Residual: a paranormal field-investigation experience (spirit box + visual anomaly scanner).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node tools/copy-build.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "voicebank": "python3 tools/build-voicebank.py",
    "e2e:media": "python3 e2e/make-media.py",
    "e2e": "node e2e/run.mjs",
    "e2e:gallery": "node e2e/anomaly-gallery.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
